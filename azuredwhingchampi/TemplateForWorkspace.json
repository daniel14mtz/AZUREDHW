						"     format: 'parquet') ~> sourcebronze",
						"sourcebronze filter(UnitPrice >= 100) ~> filterLessThan100",
						"filterLessThan100 derive(Domain = split(CustomerEmail, '@')) ~> AddDomain",
						"AddDomain derive(Domain = slice(Domain, 2)[1]) ~> FetchOnlyDomain",
						"FetchOnlyDomain sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SilverDestination"
